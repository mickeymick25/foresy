      "listen": "test",
      "script": {
        "exec": [
          "pm.test('Garde PM-6 — 401/403/500 métier inattendu', function () {",
          "    var authOuInfra = ['Signup','Login','Refresh Token','Logout','Revoke Token','Revoke All Tokens','OAuth Callback','OAuth Failure','Root - API Status','Health Check'];",
          "    if (authOuInfra.indexOf(pm.info.requestName) !== -1) { return; }",
          "    pm.expect([401,403,500]).to.not.include(pm.response.code);",
          "});"
