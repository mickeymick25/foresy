            },
            "description": "Archive une mission (soft delete). Retourne 409 Conflict si la mission est liée à un CRA."
          },
          "response": []
        }
      ]
    },
    {
      "name": "CRAs",
      "description": "Gestion des CRA (Comptes Rendus d'Activité) — CRUD + submit, lock, export (requiert Authorization pour tous les endpoints).",
      "item": [
        {
          "name": "Create CRA",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('CRA created', function () {",
                  "    if (pm.response.code === 201) {",
                  "        var jsonData = pm.response.json();",
                  "        pm.test('CRA ID present', function () { pm.expect(jsonData.id).to.not.be.empty; });",
                  "        if (jsonData.id) {",
                  "            pm.collectionVariables.set('cra_id', jsonData.id);",
                  "        }",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"month\": 1,\n  \"year\": 2026,\n  \"description\": \"CRA Janvier 2026\",\n  \"currency\": \"EUR\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/cras",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "cras"]
