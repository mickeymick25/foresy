    {
      "name": "Authentication",
      "description": "Inscription, connexion, refresh, logout, révocation de tokens et OAuth.\n\n## Contrat d'erreur\n\nErreurs standardisées : `{ \"code\": \"ERROR_CODE\", \"message\": \"...\", \"details\": {} }`",
      "item": [
        {
          "name": "Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Signup response is valid', function () {",
                  "    if (pm.response.code === 201) {",
                  "        var jsonData = pm.response.json();",
                  "        pm.test('Token present', function () { pm.expect(jsonData.token).to.not.be.empty; });",
                  "        if (jsonData.token) {",
                  "            pm.collectionVariables.set('jwt_token', jsonData.token);",
                  "        }",
                  "        if (jsonData.refresh_token) {",
                  "            pm.collectionVariables.set('refresh_token', jsonData.refresh_token);",
                  "        }",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@foresy.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/signup",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "signup"
              ]
            },
            "description": "Créer un nouveau compte. Retourne `token` + `refresh_token` (HTTP 201)."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login response is valid', function () {",
                  "    if (pm.response.code === 200) {",
                  "        var jsonData = pm.response.json();",
                  "        pm.test('Token present', function () { pm.expect(jsonData.token).to.not.be.empty; });",
                  "        if (jsonData.token) {",
                  "            pm.collectionVariables.set('jwt_token', jsonData.token);",
                  "        }",
                  "        if (jsonData.refresh_token) {",
                  "            pm.collectionVariables.set('refresh_token', jsonData.refresh_token);",
                  "        }",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@foresy.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Connexion (email + password). Retourne `token` + `refresh_token` (HTTP 200)."
          },
          "response": []
        },
        {
          "name": "OAuth Callback",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OAuth callback response is valid', function () {",
                  "    if (pm.response.code === 200) {",
                  "        var jsonData = pm.response.json();",
                  "        if (jsonData.token) {",
                  "            pm.collectionVariables.set('jwt_token', jsonData.token);",
                  "        }",
                  "        if (jsonData.refresh_token) {",
                  "            pm.collectionVariables.set('refresh_token', jsonData.refresh_token);",
                  "        }",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{oauth_code}}\",\n  \"redirect_uri\": \"{{base_url}}/api/v1/auth/{{provider}}/callback\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/{{provider}}/callback",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "{{provider}}",
                "callback"
              ],
              "variable": [
                {
                  "key": "provider",
                  "value": "google_oauth2",
                  "description": "Provider OAuth : `google_oauth2` ou `github`"
                }
              ]
            },
            "description": "OAuth callback — envoie le code d'autorisation reçu du provider.\n\nProviders supportés : `google_oauth2`, `github`.\n\n⚠️ Le code OAuth expire en ~30 secondes. Remplacez `{{oauth_code}}` par le code obtenu via l'URL d'autorisation du provider."
          },
          "response": []
        },
        {
          "name": "OAuth Failure",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/failure",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "failure"
              ]
            },
            "description": "Endpoint appelé en cas d'échec OAuth."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Companies",
      "description": "FC-08 (§36-37) — Companies : onboarding atomique (company + rôle en un POST, §37.2), listage actif (§36.1), fiche, mise à jour (§37.3-adjacent). Création avec SIREN/SIRET uniques par exécution (INV-09/12 — replay ×2 ; jamais de valeurs en dur, cf. e2e_companies). Scripts extraient `company_id` (l'alimentation des autres dossiers/requêtes). Requiert Authorization après Login.",
      "item": [
        {
          "name": "Create Company (Onboarding atomique)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// SIREN/SIRET uniques par exécution (INV-09/12) — replay Newman ×2 sans données résiduelles",
                  "var siren = '9' + String(Date.now()).slice(-8);",
                  "pm.collectionVariables.set('company_siren', siren);",
                  "pm.collectionVariables.set('company_siret', siren + '00012');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Create Company (onboarding atomique) response is valid', function () {",
                  "    if (pm.response.code === 201) {",
                  "        var jsonData = pm.response.json();",
                  "        pm.test('Company id present', function () { pm.expect(jsonData.id).to.not.be.empty; });",
                  "        if (jsonData.id) {",
                  "            pm.collectionVariables.set('company_id', jsonData.id);",
                  "        }",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": {\n    \"name\": \"Foresy Postman\",\n    \"siren\": \"{{company_siren}}\",\n    \"siret\": \"{{company_siret}}\",\n    \"legal_form\": \"EI\",\n    \"vat_regime\": \"franchise\"\n  },\n  \"role\": \"independent\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/companies",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "companies"
              ]
            },
            "description": "Onboarding atomique (§37.2, INV-16) — company + rôle indépendant en un POST. SIREN/SIRET générés par exécution (INV-09/12). Retourne `id` (201) — extrait vers `company_id`."
          },
          "response": []
        },
